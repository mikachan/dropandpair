# Pressable GitHub deploy. Settings: Repository Subdirectory "wordpress", Destination Path
# "wp-content", so wordpress/plugins and wordpress/themes land in wp-content/plugins and
# wp-content/themes.
#
# The deploy deletes anything at the destination that isn't in the repo, unless it's listed
# here. So this file does two jobs: keep repo-only files off the server, and keep everything
# on the server that isn't ours. Pressable's docs don't say whether paths are relative to the
# repo root or to the subdirectory, so the patterns are written to match either way.

# Repo-only files
README.md
.gitignore

# Development files (production uses the plugin's own autoloader, not Composer)
**/tests/
**/composer.json
**/composer.lock
**/phpunit.xml.dist
**/.phpunit.result.cache

# Everything else on the server: other plugins and themes, and the rest of wp-content
plugins/
!**/plugins/drop-and-pair/
themes/
!**/themes/drop-and-pair/
mu-plugins/
languages/
fonts/
upgrade-temp-backup/
object-cache.php
advanced-cache.php
db.php
