{
    "name": "dropandpair/drop-and-pair",
    "description": "Drop and Pair WordPress plugin",
    "type": "wordpress-plugin",
    "require": { "php": ">=8.1" },
    "require-dev": { "phpunit/phpunit": "^11.0" },
    "autoload": { "psr-4": { "DropAndPair\\": "src/" } },
    "autoload-dev": { "psr-4": { "DropAndPair\\Tests\\": "tests/" } },
    "config": { "sort-packages": true },
    "scripts": { "test": "phpunit" }
}
